{
  "appId": "com.app.desktop",
  "productName": "app",
  "asar": {
    "smartUnpack": true
  },
  "compression": "maximum",
  "electronLanguages": [
    "en-US"
  ],
  "removePackageScripts": true,
  "removePackageKeywords": true,
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "dist",
    "buildResources": "node_modules/react-native-electron-platform/lib"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "YOUR_REPOSITORY_NAME",
      "private": false,
      "releaseType": "release"
    }
  ],
  "files": [
    "electron/**/*",
    "web/**/*",
    "package.json",
    "node_modules/react-native-electron-platform/lib/**/*",
    "node_modules/react-native-electron-platform/index.mjs",
    "!**/*.map",
    "!**/*.md",
    "!**/test/**",
    "!**/__tests__/**",
    "!**/docs/**",
    "!**/locales/**",
    "!**/example/**",
    "!**/android/**",
    "!**/ios/**",
    "!**/build/**",
    "!**/node_modules/electron/**",
    "!**/node_modules/react-native/**",
    "!node_modules/**/android/**",
    "!node_modules/**/ios/**",
    "!node_modules/**/build/**",
    "!node_modules/**/example/**"
  ],
  "asarUnpack": [
    "**/*.node"
  ],
  "extraMetadata": {
    "main": "node_modules/react-native-electron-platform/index.mjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "msi",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "electron/icon.ico"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "electron/icon.icns",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "rpm",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "electron/icons",
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "app",
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "msi": {
    "oneClick": false,
    "perMachine": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "warningsAsErrors": false
  }
}